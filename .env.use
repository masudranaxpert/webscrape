# Anti API — a production-style setup (2 vCPU, free 1-seat CloakBrowser license, WARP sidecar).
# Copy to `.env` (or set these in the nd panel), fill in the two secrets, deploy. Everything not listed
# here uses its built-in default; see .env.example for every option.

# Secrets (never commit real values)
API_KEY=change-me-to-a-long-random-string
CLOAKBROWSER_LICENSE_KEY=cb_your_key_here

PORT=8000
DEBUG=false

# Headed Chromium in Xvfb, up to 5 tabs across all browsers
BROWSER_HEADLESS=false
MAX_TABS=5

# Side by side, never evicting each other: direct traffic on the licensed PRO browser (seat holder),
# proxied traffic on one keyless browser. MAX_BROWSERS counts proxied browsers only (WARP included).
MAX_BROWSERS=1

# Optional WARP egress for the default browser: the warp service in docker-compose.yml.
# Restart needed after changing. See .env.example.
#WARP_PROXY=http://warp:8080

# Reuse Cloudflare clearance cookies for 6 hours
DEFAULT_COOKIE_TTL=21600
