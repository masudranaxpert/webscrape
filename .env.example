# ─────────────────────────────────────────────────────────────────────────────
# Anti API — environment settings
#
# Copy to `.env` and fill in the REQUIRED block. Every other value below is the
# built-in default: leave it out unless the note says when to change it.
# ─────────────────────────────────────────────────────────────────────────────


# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Secret for the X-API-Key header (also guards /cookies and the web playground).
# The app refuses to start without it unless DEBUG=true. Use a long random value.
API_KEY=change-me-to-a-long-random-string

# CloakBrowser license key (cb_...). Enables the latest stealth build (v154+).
# Without a key everything runs on the keyless v146 build, which Cloudflare
# challenges more often. Free key: https://cloakbrowser.dev/free (1 concurrent session).
CLOAKBROWSER_LICENSE_KEY=


# ── SERVER ───────────────────────────────────────────────────────────────────

PORT=8000

# true = verbose logs and the app starts even without API_KEY. Keep false in production.
DEBUG=false


# ── BROWSER ENGINE ───────────────────────────────────────────────────────────

# false = headed Chromium inside the container's Xvfb display (harder to detect).
# true only when running without a display or to save CPU on a tiny host.
BROWSER_HEADLESS=false

# Match timezone, locale and WebRTC IP to the egress IP (GeoIP DB is baked into the
# image). Turn off only if the GeoIP lookups fail in your network.
BROWSER_GEOIP=true

# Max browser tabs open at once, across all browser processes.
# Rule of thumb: about 2 per vCPU. Lower it if the host load stays above its CPU count.
MAX_TABS=5


# ── BROWSER POOL & LICENSE SEAT ──────────────────────────────────────────────
# One Chromium process per egress identity (direct, or each proxy), because proxy,
# timezone and WebRTC IP are set per process.

# Browser processes alive at once. With 1 it swaps processes every time traffic
# alternates between direct and proxied requests (slow, CPU heavy).
#   1-seat license + mixed direct/proxy traffic → MAX_BROWSERS=2 and
#   BROWSER_LICENSED_IDENTITY=proxy (recommended setup)
#   Paid plan with N seats → MAX_BROWSERS up to N
MAX_BROWSERS=1

# Who gets the license seat: any (first come) | proxy | direct.
# `proxy` puts the licensed build on proxied (Cloudflare-heavy) traffic and runs direct
# traffic on the keyless v146 build, so the two never evict each other.
BROWSER_LICENSED_IDENTITY=any

# Idle lifetime (seconds) before a browser is recycled to shed memory.
# Unlicensed browsers use BROWSER_MAX_LIFETIME_SEC; the seat holder stays warm longer.
BROWSER_MAX_LIFETIME_SEC=300
BROWSER_LICENSED_LIFETIME_SEC=3600

# How often (seconds) a proxied browser re-checks its exit IP in the background.
# Same IP: keeps serving. New IP (rotating proxy): finishes its open tabs, closes,
# drops the old IP's clearance cookies, and the next request opens a fresh browser.
BROWSER_EXIT_IP_CHECK_SEC=60


# ── LIVENESS TIMEOUTS ────────────────────────────────────────────────────────
# These guarantee a stuck page can never freeze the pool.

# Hard ceiling per browser job = request cf_wait + this (queue wait included); a job
# past it is cancelled with 504. Keep cf_wait + this below your client's HTTP timeout
# (client-app uses 150s, so 45 + 90 = 135 fits).
BROWSER_JOB_OVERHEAD_SEC=90

# Longest a request waits for a free browser slot before failing fast with 503.
BROWSER_QUEUE_TIMEOUT_SEC=60

# Ceiling for single page calls (evaluate, content, cookies). Raise only on a very slow host.
BROWSER_CALL_TIMEOUT_SEC=10

# Ceiling for one humanized Turnstile click. Clicks take 2s on an idle host and 20s+
# under load; too low cancels the click mid-way and the widget never solves.
BROWSER_CLICK_TIMEOUT_SEC=30


# ── PROXY (optional) ─────────────────────────────────────────────────────────
# Use residential/ISP proxies for Cloudflare sites; datacenter/VPN ranges get
# challenged on reputation. Formats: http://user:pass@host:port, https://...,
# socks5://user:pass@host:port, socks5h://...

# Applied to requests that send no `proxy` field, so clients never need the
# credentials. A request can still pass its own proxy, or "direct" to skip this.
DEFAULT_PROXY=

# Comma-separated domains routed through DEFAULT_PROXY (subdomains included).
# Empty = every domain. Example: target-site.site,example.com
DEFAULT_PROXY_DOMAINS=


# ── COOKIE CACHE ─────────────────────────────────────────────────────────────
# In-memory; cleared on restart.

# Seconds a domain's clearance cookies are reused (requests can override with cookie_ttl).
DEFAULT_COOKIE_TTL=86400

# Seconds an isolated session_id jar lives (multi-step flows like a download gateway).
DEFAULT_SESSION_TTL=600

# Max cached domains / sessions before the least recently used is dropped.
MAX_CACHED_DOMAINS=64
MAX_CACHED_SESSIONS=256
