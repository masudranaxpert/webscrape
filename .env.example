# Server Settings
DEBUG=false
PORT=8000
API_KEY=anti_secret_key_123

# Browser Pool
BROWSER_HEADLESS=false
MAX_TABS=5
# One browser process per egress identity; keep <= CloakBrowser license seats
MAX_BROWSERS=1
BROWSER_GEOIP=true
# Liveness: a browser job never exceeds cf_wait + BROWSER_JOB_OVERHEAD_SEC (504), queueing never exceeds
# BROWSER_QUEUE_TIMEOUT_SEC (503), and single page calls never exceed BROWSER_CALL_TIMEOUT_SEC
BROWSER_JOB_OVERHEAD_SEC=90
BROWSER_QUEUE_TIMEOUT_SEC=60
BROWSER_CALL_TIMEOUT_SEC=10
# Humanized Turnstile clicks are slow on a loaded host; cancelling mid-path means no click lands
BROWSER_CLICK_TIMEOUT_SEC=30
VERBOSE_BROWSER_LOGS=false
CLOAKBROWSER_LICENSE_KEY=

# Cache
DEFAULT_COOKIE_TTL=3600
MAX_CACHED_DOMAINS=64

# Proxy (optional): residential/ISP recommended. Requests without `proxy` use it; send proxy="direct" to bypass
DEFAULT_PROXY=
# Comma-separated domains routed through DEFAULT_PROXY (subdomains included); empty = all domains
DEFAULT_PROXY_DOMAINS=
