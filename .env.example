# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Secret for the X-API-Key header; app refuses to start without it unless DEBUG=true.
API_KEY=change-me-to-a-long-random-string
# CloakBrowser license key (cb_...); empty = keyless v146 build (challenged more often).
# Free key (1 concurrent session): https://cloakbrowser.dev/free
CLOAKBROWSER_LICENSE_KEY=

# ── SERVER ───────────────────────────────────────────────────────────────────

PORT=8000
# true = verbose logs; app starts even without API_KEY. Keep false in production.
DEBUG=false

# ── BROWSER ENGINE ───────────────────────────────────────────────────────────

# false = headed Chromium inside Xvfb (harder to detect).
BROWSER_HEADLESS=false
# Match timezone/locale/WebRTC IP to the egress IP.
BROWSER_GEOIP=true
# Tabs open at once across all browser processes; ~2 per vCPU.
MAX_TABS=5

# ── BROWSER POOL ─────────────────────────────────────────────────────────────
# MAX_BROWSERS = proxy browsers (requests with a proxy URL) allowed at once. The default browser (WARP when set,
# else direct) and the direct browser are never counted and the default is never closed.
#   0 = proxy browsers off (409); default/direct still work
#   N = up to N proxies in parallel; the least recently used idle proxy browser is replaced
MAX_BROWSERS=1

# Close browsers other than the default one after this many seconds without a tab (0 = keep them).
# The default browser (WARP when set, else direct) is never closed and is kept launched.
BROWSER_IDLE_SHUTDOWN_SEC=600
BROWSER_MAX_LIFETIME_SEC=300
BROWSER_LICENSED_LIFETIME_SEC=3600
# Exit-IP change retires the proxied browser and drops its clearance cookies.
BROWSER_EXIT_IP_CHECK_SEC=60

# ── LIVENESS TIMEOUTS ────────────────────────────────────────────────────────

# Hard job ceiling = cf_wait + this -> 504 past it. Keep below the client's timeout.
BROWSER_JOB_OVERHEAD_SEC=90
BROWSER_QUEUE_TIMEOUT_SEC=60
BROWSER_CALL_TIMEOUT_SEC=10
BROWSER_CLICK_TIMEOUT_SEC=30
# Request-body bytes queued at once for proxied browser slots.
PROXY_QUEUE_BYTE_LIMIT=16777216

# ── PROXY (per request only) ─────────────────────────────────────────────────
# A proxy (or 'direct') in the request pins BOTH engines to it. No proxy field = hybrid (see WARP). Formats:
#   http://user:pass@host:port, https://..., socks5://..., socks5h://...
# Residential/ISP suits Cloudflare sites; datacenter ranges get challenged.

# ── WARP (optional default BROWSER egress) ───────────────────────────────────
#   WARP_PROXY=http://warp:8080  (the warp service in docker-compose.yml)
# Requests without a proxy field: the HTTP engine goes DIRECT; only the browser escalation goes through WARP.
# Once WARP earned cf_clearance for a host, that host's HTTP requests follow it through WARP (clearance only
# works from the IP that earned it). Hosts WARP never solved stay direct. Restart to change.
WARP_PROXY=
# true = allow fetching localhost/private IPs/internal names (SSRF guard off). Local development only.
ALLOW_PRIVATE_TARGETS=false

# ── RESPONSE SIZE ────────────────────────────────────────────────────────────

# Largest body (MB) the HTTP engine reads; binary/oversized -> status + headers + final URL.
MAX_RESPONSE_MB=16

# ── COOKIE CACHE (in-memory, persisted to disk) ──────────────────────────────
# Written every 30s when changed and at shutdown; restored on start, so clearances survive deploys.
# Least recently used entries are dropped past the size cap. Empty COOKIE_CACHE_FILE = memory only.
COOKIE_CACHE_FILE=/app/data/cookie_cache.json
COOKIE_CACHE_MAX_MB=20

DEFAULT_COOKIE_TTL=86400
DEFAULT_SESSION_TTL=600
MAX_CACHED_DOMAINS=64
MAX_CACHED_SESSIONS=256

# ── TURNSTILE SOLVER (/solve-turnstile) ──────────────────────────────────────
# Tokens are single-use (300s): never shared or cached for reuse. One warm widget page per sitekey mints them
# back to back (turnstile.reset); requests queue oldest-first and a burst pre-mints a few spares.
TURNSTILE_MAX_QUEUE=200
# More than 1 makes Cloudflare escalate difficulty for that sitekey; raise only if you measured it helps.
TURNSTILE_MINTERS_PER_KEY=1
TURNSTILE_PREFETCH=0
